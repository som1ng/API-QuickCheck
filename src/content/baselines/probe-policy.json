{
  "schemaVersion": "2.0",
  "catalogVersion": "2026-08-17",
  "description": "API-QuickCheck 24项全量探针路由与执行策略规范 (涵盖 P0协议层, P1架构层, P2能力层, P3质量层)",
  "executionSemantics": {
    "supported": {
      "mode": "standard_benchmark",
      "action": "execute",
      "scoring": "计入能力与真伪核心评分，探针失败判定为潜在掺水或功能降级"
    },
    "unsupported": {
      "mode": "not_claimed",
      "action": "skip",
      "scoring": "自动跳过，状态标记为 not_applicable / not_claimed，不计入扣分"
    },
    "unknown": {
      "mode": "exploratory_test",
      "action": "execute_optional",
      "scoring": "作为探索性探针运行，测试结果仅供质量洞察，不参与官方级降级定论"
    }
  },
  "longContextPolicy": {
    "needleProbeTokens": 64000,
    "needlePositions": ["start", "middle", "end"],
    "tokenEstimationRatio": "char_count_div_4_or_bpe",
    "minOfficialContextForNeedle": 64000,
    "skipWhen": ["contextWindowTokens < 64000", "contextWindowTokens=unknown"]
  },
  "probePolicy": {
    "p0-model-discovery": {
      "layer": "P0",
      "title": "模型与版本发现",
      "domain": "protocol",
      "requires": [],
      "skipWhen": [],
      "description": "探测 /v1/models 或原生型号目录端点，校验是否存在目标模型 ID 或合法别名映射"
    },
    "p0-native-route": {
      "layer": "P0",
      "title": "原生 API 路由",
      "domain": "protocol",
      "requires": [],
      "skipWhen": [],
      "description": "验证 Responses / Messages / Interactions 原生 API 协议路由与状态码响应"
    },
    "p0-auth-shape": {
      "layer": "P0",
      "title": "认证头与错误语义",
      "domain": "protocol",
      "requires": [],
      "skipWhen": [],
      "description": "验证 Bearer / x-api-key 认证鉴权失败时，错误码与 JSON Error Envelope 规范"
    },
    "p0-stream-events": {
      "layer": "P0",
      "title": "流式事件顺序",
      "domain": "protocol",
      "requires": ["streaming=supported"],
      "skipWhen": ["streaming=unsupported"]
    },
    "p0-strict-json": {
      "layer": "P0",
      "title": "严格 JSON Schema",
      "domain": "structured_output",
      "requires": ["structuredOutput=supported", "jsonSchema=supported"],
      "skipWhen": ["structuredOutput=unsupported", "jsonSchema=unsupported"]
    },
    "p0-tool-shape": {
      "layer": "P0",
      "title": "工具调用结构",
      "domain": "tools",
      "requires": ["toolCalling=supported"],
      "skipWhen": ["toolCalling=unsupported"]
    },
    "p0-invalid-parameter": {
      "layer": "P0",
      "title": "非法参数回显",
      "domain": "protocol",
      "requires": [],
      "skipWhen": [],
      "description": "传入非法 temperature / top_p / thinking_budget，验证服务端原生拦截报错"
    },
    "p1-reasoning-config": {
      "layer": "P1",
      "title": "推理配置透传",
      "domain": "reasoning",
      "requires": ["provider=anthropic", "reasoning=supported"],
      "skipWhen": ["provider!=anthropic", "reasoning=unsupported"]
    },
    "p1-state-continuity": {
      "layer": "P1",
      "title": "跨轮状态连续性",
      "domain": "tools",
      "requires": ["statefulConversation=supported"],
      "skipWhen": ["statefulConversation=unsupported"]
    },
    "p1-tool-roundtrip": {
      "layer": "P1",
      "title": "受控工具回合",
      "domain": "tools",
      "requires": ["toolCalling=supported"],
      "skipWhen": ["toolCalling=unsupported"]
    },
    "p1-signature-continuity": {
      "layer": "P1",
      "title": "思考签名连续性",
      "domain": "protocol",
      "requires": ["provider=anthropic", "reasoning=supported"],
      "skipWhen": ["provider!=anthropic", "reasoning=unsupported"]
    },
    "p1-cache-semantics": {
      "layer": "P1",
      "title": "缓存语义",
      "domain": "protocol",
      "requires": ["promptCaching=supported"],
      "skipWhen": ["promptCaching=unsupported"]
    },
    "p2-constraint-json": {
      "layer": "P2",
      "title": "约束 JSON 任务",
      "domain": "structured_output",
      "requires": ["structuredOutput=supported", "inputModalities.text=supported", "outputModalities.text=supported"],
      "skipWhen": ["structuredOutput=unsupported"]
    },
    "p2-tool-planning": {
      "layer": "P2",
      "title": "双回合工具规划",
      "domain": "tools",
      "requires": ["toolCalling=supported"],
      "skipWhen": ["toolCalling=unsupported"]
    },
    "p2-code-repair-a": {
      "layer": "P2",
      "title": "代码补丁：算术模块",
      "domain": "code",
      "requires": ["inputModalities.text=supported", "outputModalities.text=supported"],
      "skipWhen": []
    },
    "p2-code-repair-b": {
      "layer": "P2",
      "title": "代码补丁：集合模块",
      "domain": "code",
      "requires": ["inputModalities.text=supported", "outputModalities.text=supported"],
      "skipWhen": []
    },
    "p2-chart-extraction": {
      "layer": "P2",
      "title": "图表字段提取",
      "domain": "vision",
      "requires": ["vision=supported", "inputModalities.image=supported"],
      "skipWhen": ["vision=unsupported", "inputModalities.image=unsupported"]
    },
    "p2-context-start": {
      "layer": "P2",
      "title": "长上下文针尖：开头",
      "domain": "context",
      "requires": ["contextWindowTokens >= 64000"],
      "minimumContextTokens": 64000,
      "skipWhen": ["contextWindowTokens < 64000", "contextWindowTokens=unknown"]
    },
    "p2-context-middle": {
      "layer": "P2",
      "title": "长上下文针尖：中部",
      "domain": "context",
      "requires": ["contextWindowTokens >= 64000"],
      "minimumContextTokens": 64000,
      "skipWhen": ["contextWindowTokens < 64000", "contextWindowTokens=unknown"]
    },
    "p2-context-end": {
      "layer": "P2",
      "title": "长上下文针尖：结尾",
      "domain": "context",
      "requires": ["contextWindowTokens >= 64000"],
      "minimumContextTokens": 64000,
      "skipWhen": ["contextWindowTokens < 64000", "contextWindowTokens=unknown"]
    },
    "p3-repeat-a": {
      "layer": "P3",
      "title": "运行质量样本 A",
      "domain": "runtime",
      "requires": [],
      "skipWhen": [],
      "description": "基础冷启动延迟与首 Token 测速采样"
    },
    "p3-repeat-b": {
      "layer": "P3",
      "title": "运行质量样本 B",
      "domain": "runtime",
      "requires": [],
      "skipWhen": [],
      "description": "并发稳定性与连续 Token 吞吐率采样"
    },
    "p3-repeat-c": {
      "layer": "P3",
      "title": "运行质量样本 C",
      "domain": "runtime",
      "requires": [],
      "skipWhen": [],
      "description": "网络抖动与长连保活测试采样"
    },
    "p3-repeat-d": {
      "layer": "P3",
      "title": "运行质量样本 D",
      "domain": "runtime",
      "requires": [],
      "skipWhen": [],
      "description": "综合稳定性与端到端 P95 延迟判定采样"
    }
  }
}
