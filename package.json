{
  "name": "api-quickcheck",
  "version": "3.2.0",
  "description": "Industrial-grade Headless AI API Quality Audit & Anti-Counterfeiting Platform (CPU-Z + Geekbench for AI APIs)",
  "type": "module",
  "author": "som1ng",
  "license": "MIT",
  "homepage": "https://api-quick-check.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/som1ng/API-QuickCheck.git"
  },
  "keywords": [
    "ai",
    "llm",
    "api-audit",
    "benchmark",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "grok",
    "deepseek",
    "cli"
  ],
  "bin": {
    "api-quickcheck": "./bin/apiqc.js",
    "apiqc": "./bin/apiqc.js"
  },
  "files": [
    "bin",
    "README.md",
    "README_zh.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:web": "tsc -b && vite build",
    "build:cli": "esbuild scripts/apiqc.ts --bundle --platform=node --target=node18 --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=bin/apiqc.js",
    "build": "npm run build:web && npm run build:cli",
    "lint": "eslint .",
    "apiqc": "tsx scripts/apiqc.ts",
    "sync:audit-baselines": "tsx scripts/sync-audit-baselines.ts",
    "sync:models": "tsx scripts/sync-model-baselines.ts",
    "test": "tsx --test tests/audit.test.ts tests/leaderboard.test.ts",
    "sync:leaderboards": "tsx scripts/sync-leaderboards.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "^0.18.4",
    "lucide-react": "^1.14.0",
    "mermaid": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "esbuild": "^0.24.0",
    "globals": "^15.11.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  }
}
